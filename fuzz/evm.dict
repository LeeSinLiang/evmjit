# EVM Bytecode Dictionary for LibFuzzer
# This dictionary contains important byte values for EVM bytecode fuzzing
# Format: "value" or "\xHH" for hex values

# Stop and arithmetic operations
"\x00"  # STOP
"\x01"  # ADD
"\x02"  # MUL
"\x03"  # SUB
"\x04"  # DIV
"\x05"  # SDIV
"\x06"  # MOD
"\x07"  # SMOD
"\x08"  # ADDMOD
"\x09"  # MULMOD
"\x0a"  # EXP
"\x0b"  # SIGNEXTEND

# Comparison & bitwise logic operations
"\x10"  # LT
"\x11"  # GT
"\x12"  # SLT
"\x13"  # SGT
"\x14"  # EQ
"\x15"  # ISZERO
"\x16"  # AND
"\x17"  # OR
"\x18"  # XOR
"\x19"  # NOT
"\x1a"  # BYTE

# SHA3
"\x20"  # SHA3

# Environmental information
"\x30"  # ADDRESS
"\x31"  # BALANCE
"\x32"  # ORIGIN
"\x33"  # CALLER
"\x34"  # CALLVALUE
"\x35"  # CALLDATALOAD
"\x36"  # CALLDATASIZE
"\x37"  # CALLDATACOPY
"\x38"  # CODESIZE
"\x39"  # CODECOPY
"\x3a"  # GASPRICE
"\x3b"  # EXTCODESIZE
"\x3c"  # EXTCODECOPY
"\x3d"  # RETURNDATASIZE
"\x3e"  # RETURNDATACOPY

# Block information
"\x40"  # BLOCKHASH
"\x41"  # COINBASE
"\x42"  # TIMESTAMP
"\x43"  # NUMBER
"\x44"  # DIFFICULTY
"\x45"  # GASLIMIT

# Stack, memory, storage and flow operations
"\x50"  # POP
"\x51"  # MLOAD
"\x52"  # MSTORE
"\x53"  # MSTORE8
"\x54"  # SLOAD
"\x55"  # SSTORE
"\x56"  # JUMP
"\x57"  # JUMPI
"\x58"  # PC
"\x59"  # MSIZE
"\x5a"  # GAS
"\x5b"  # JUMPDEST

# PUSH operations (PUSH1-PUSH32)
"\x60"  # PUSH1
"\x61"  # PUSH2
"\x62"  # PUSH3
"\x63"  # PUSH4
"\x64"  # PUSH5
"\x65"  # PUSH6
"\x66"  # PUSH7
"\x67"  # PUSH8
"\x68"  # PUSH9
"\x69"  # PUSH10
"\x6a"  # PUSH11
"\x6b"  # PUSH12
"\x6c"  # PUSH13
"\x6d"  # PUSH14
"\x6e"  # PUSH15
"\x6f"  # PUSH16
"\x70"  # PUSH17
"\x71"  # PUSH18
"\x72"  # PUSH19
"\x73"  # PUSH20
"\x74"  # PUSH21
"\x75"  # PUSH22
"\x76"  # PUSH23
"\x77"  # PUSH24
"\x78"  # PUSH25
"\x79"  # PUSH26
"\x7a"  # PUSH27
"\x7b"  # PUSH28
"\x7c"  # PUSH29
"\x7d"  # PUSH30
"\x7e"  # PUSH31
"\x7f"  # PUSH32

# Duplication operations (DUP1-DUP16)
"\x80"  # DUP1
"\x81"  # DUP2
"\x82"  # DUP3
"\x83"  # DUP4
"\x84"  # DUP5
"\x85"  # DUP6
"\x86"  # DUP7
"\x87"  # DUP8
"\x88"  # DUP9
"\x89"  # DUP10
"\x8a"  # DUP11
"\x8b"  # DUP12
"\x8c"  # DUP13
"\x8d"  # DUP14
"\x8e"  # DUP15
"\x8f"  # DUP16

# Exchange operations (SWAP1-SWAP16)
"\x90"  # SWAP1
"\x91"  # SWAP2
"\x92"  # SWAP3
"\x93"  # SWAP4
"\x94"  # SWAP5
"\x95"  # SWAP6
"\x96"  # SWAP7
"\x97"  # SWAP8
"\x98"  # SWAP9
"\x99"  # SWAP10
"\x9a"  # SWAP11
"\x9b"  # SWAP12
"\x9c"  # SWAP13
"\x9d"  # SWAP14
"\x9e"  # SWAP15
"\x9f"  # SWAP16

# Logging operations (LOG0-LOG4)
"\xa0"  # LOG0
"\xa1"  # LOG1
"\xa2"  # LOG2
"\xa3"  # LOG3
"\xa4"  # LOG4

# System operations
"\xf0"  # CREATE
"\xf1"  # CALL
"\xf2"  # CALLCODE
"\xf3"  # RETURN
"\xf4"  # DELEGATECALL
"\xfa"  # STATICCALL
"\xfd"  # REVERT
"\xff"  # SELFDESTRUCT

# Common PUSH1 values
"\x60\x00"  # PUSH1 0
"\x60\x01"  # PUSH1 1
"\x60\x20"  # PUSH1 32
"\x60\x40"  # PUSH1 64
"\x60\x60"  # PUSH1 96
"\x60\x80"  # PUSH1 128
"\x60\xff"  # PUSH1 255

# Common instruction sequences
"\x60\x00\x35"  # PUSH1 0, CALLDATALOAD
"\x60\x00\x51"  # PUSH1 0, MLOAD
"\x60\x40\x51"  # PUSH1 64, MLOAD (free memory pointer)
"\x5b\x56"      # JUMPDEST, JUMP
"\x5b\x57"      # JUMPDEST, JUMPI
"\x60\x00\x56"  # PUSH1 0, JUMP
"\x60\x00\xf3"  # PUSH1 0, RETURN
"\x60\x00\x80"  # PUSH1 0, DUP1
"\x60\x00\x52"  # PUSH1 0, MSTORE

# Common larger values (32-byte)
"\x7f\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"  # PUSH32 0
"\x7f\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"  # PUSH32 max

# Invalid opcodes for edge case testing
"\x0c"  # Invalid
"\x0d"  # Invalid
"\x0e"  # Invalid
"\x0f"  # Invalid
"\x1c"  # Invalid
"\x1d"  # Invalid
"\x1e"  # Invalid
"\x1f"  # Invalid
"\x21"  # Invalid
"\x49"  # Invalid
"\x4a"  # Invalid
"\x4b"  # Invalid
"\x4c"  # Invalid
"\x4d"  # Invalid
"\x4e"  # Invalid
"\x4f"  # Invalid
"\x5c"  # Invalid
"\x5d"  # Invalid
"\x5e"  # Invalid
"\x5f"  # Invalid
"\xa5"  # Invalid
"\xa6"  # Invalid
"\xf5"  # Invalid
"\xf6"  # Invalid
"\xf7"  # Invalid
"\xf8"  # Invalid
"\xf9"  # Invalid
"\xfb"  # Invalid
"\xfc"  # Invalid
"\xfe"  # Invalid
